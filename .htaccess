    RewriteRule ^fr/ecoles-internationales-en-suisse-chauffeur-prive/?$ https://www.lux-taxi.com/geneva-airport-transfer/ [R=301,L,QSD,NE]
    RewriteRule ^corporate-travel-simplified-vip-transfers/?$ https://www.lux-taxi.com/corporate-chauffeur-geneva/ [R=301,L,QSD,NE]
    RewriteRule ^fr/voyages-affaires-transferts-lux‑taxi/?$ https://www.lux-taxi.com/chauffeur-by-the-hour/ [R=301,L,QSD,NE]
    RewriteRule ^fr/voyages-affaires-transferts-lux-taxi/?$ https://www.lux-taxi.com/chauffeur-by-the-hour/ [R=301,L,QSD,NE]
    RewriteRule ^fr/taxi-depuis-lausanne-vers-aeroport-geneve/?$ https://www.lux-taxi.com/geneva-airport-transfer/ [R=301,L,QSD,NE]
    RewriteRule ^geneva-to-chamonix-ski-transfers/?$ https://www.lux-taxi.com/ski-transfers/ [R=301,L,QSD,NE]
    RewriteRule ^fr/chauffeur-prive-palexpo-geneve/?$ https://www.lux-taxi.com/chauffeur-by-the-hour/ [R=301,L,QSD,NE]
    RewriteRule ^private-chauffeur-palexpo-geneva/?$ https://www.lux-taxi.com/chauffeur-by-the-hour/ [R=301,L,QSD,NE]
    RewriteRule ^fr/chauffeur-prive-ephj-geneve/?$ https://www.lux-taxi.com/chauffeur-by-the-hour/ [R=301,L,QSD,NE]
    RewriteRule ^private-chauffeur-ephj-geneva/?$ https://www.lux-taxi.com/chauffeur-by-the-hour/ [R=301,L,QSD,NE]
    RewriteRule ^taxi-montreux-jazz-festival/?$ https://www.lux-taxi.com/chauffeur-by-the-hour/ [R=301,L,QSD,NE]
    RewriteRule ^fr/taxi-montreux-jazz-festival/?$ https://www.lux-taxi.com/chauffeur-by-the-hour/ [R=301,L,QSD,NE]
    RewriteRule ^private-wine-tour-with-chauffeur-in-switzerland/?$ https://www.lux-taxi.com/chauffeur-by-the-hour/ [R=301,L,QSD,NE]
    RewriteRule ^michelin-restaurant-crissier-with-private-chauffeur/?$ https://www.lux-taxi.com/chauffeur-by-the-hour/ [R=301,L,QSD,NE]
    RewriteRule ^pages/services\.html/?$ https://www.lux-taxi.com/geneva-airport-transfer/ [R=301,L,QSD,NE]
    RewriteRule ^pages/destinations\.html/?$ https://www.lux-taxi.com/ski-transfers/ [R=301,L,QSD,NE]
    RewriteRule ^pages/flotte\.html/?$ https://www.lux-taxi.com/ [R=301,L,QSD,NE]
    RewriteRule ^pages/contact\.html/?$ https://www.lux-taxi.com/ [R=301,L,QSD,NE]
    RewriteRule ^pages/reservation\.html/?$ https://www.lux-taxi.com/ [R=301,L,QSD,NE]
    RewriteRule ^fr/reserve/?$ https://www.lux-taxi.com/ [R=301,L,QSD,NE]
    RewriteRule ^reserve/?$ https://www.lux-taxi.com/ [R=301,L,QSD,NE]
    RewriteRule ^fr/from/?$ https://www.lux-taxi.com/ [R=301,L,QSD,NE]
    RewriteRule ^terms/?$ https://www.lux-taxi.com/ [R=301,L,QSD,NE]
    RewriteRule ^privacy-policy/?$ https://www.lux-taxi.com/ [R=301,L,QSD,NE]
    RewriteRule ^cookie-policy/?$ https://www.lux-taxi.com/ [R=301,L,QSD,NE]
    RewriteRule ^fr/conditions-generales/?$ https://www.lux-taxi.com/ [R=301,L,QSD,NE]
    RewriteRule ^fr/politique-de-confidentialite/?$ https://www.lux-taxi.com/ [R=301,L,QSD,NE]
    RewriteRule ^fr/politique-de-cookies/?$ https://www.lux-taxi.com/ [R=301,L,QSD,NE]
    RewriteCond %{THE_REQUEST} \s/index\.html[\s?]
    RewriteRule ^index\.html/?$ https://www.lux-taxi.com/ [R=301,L,QSD,NE]
    RewriteRule ^(fr/)?ourfleet(/.*)?$ https://www.lux-taxi.com/ [R=301,L,QSD,NE]
    RewriteRule ^(fr/)?(service|service_category)(/.*)?$ https://www.lux-taxi.com/geneva-airport-transfer/ [R=301,L,QSD,NE]
    RewriteRule ^(fr/)?(category|tag|author|blog|feed)(/.*)?$ https://www.lux-taxi.com/ [R=301,L,QSD,NE]
    RewriteRule ^(it|ru|de|en)(/.*)?$ https://www.lux-taxi.com/ [R=301,L,QSD,NE]
    RewriteRule ^fr/.+$ https://www.lux-taxi.com/ [R=301,L,QSD,NE]

    # Une seule version du site : https://www.lux-taxi.com (en un seul saut)
    RewriteCond %{HTTPS} off [OR]
    RewriteCond %{HTTP_HOST} ^lux-taxi\.com$ [NC]
    RewriteRule ^(.*)$ https://www.lux-taxi.com/$1 [R=301,L,NE]
</IfModule>
# <<< FIN REDIRECTIONS 301

# 2. EN-TÊTES DE SÉCURITÉ PALACE
<IfModule mod_headers.c>
    # Protection contre le MIME-sniffing
    Header set X-Content-Type-Options "nosniff"

    # Protection contre le clickjacking
    Header set X-Frame-Options "SAMEORIGIN"

    # Protection XSS
    Header set X-XSS-Protection "1; mode=block"

    # Rétention du Referrer pour confidentialité
    Header set Referrer-Policy "strict-origin-when-cross-origin"

    # Forcer HSTS (Strict-Transport-Security) si HTTPS actif
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
</IfModule>

# 3. COMPRESSION GZIP & BROTLI (ACCÉLÉRATION SITE RAPIDE)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE font/ttf
    AddOutputFilterByType DEFLATE font/otf
    AddOutputFilterByType DEFLATE font/woff
    AddOutputFilterByType DEFLATE font/woff2
</IfModule>

# 4. GESTION DU CACHE NAVIGATEUR (EXPIRES HEADERS)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"

    # HTML / Données dynamiques (1 heure pour mises à jour fraîches)
    ExpiresByType text/html "access plus 1 hour"
    ExpiresByType application/json "access plus 1 hour"
    ExpiresByType application/xml "access plus 1 hour"
    ExpiresByType text/xml "access plus 1 hour"

    # Feuilles de style et Scripts (1 an avec versioning ou cache fort)
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"

    # Images et Multimédia (1 an)
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType video/mp4 "access plus 1 year"

    # Typographies Web
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/otf "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# 5. TYPES MIME RECONNUS
<IfModule mod_mime.c>
    AddType text/css .css
    AddType application/javascript .js
    AddType application/json .json
    AddType image/webp .webp
    AddType image/svg+xml .svg
    AddType font/woff2 .woff2
    AddType video/mp4 .mp4
    AddType font/woff .woff
</IfModule>

# 6. ENCODAGE PAR DÉFAUT UTF-8
AddDefaultCharset UTF-8

# 7. BLOCAGE DES FICHIERS CACHÉS & GIT
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

# 8. PAGE D'ERREUR 404 (vrai code 404 pour Google)
ErrorDocument 404 /404.html
