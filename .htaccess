    RewriteRule ^fr/tarifs-faq-transferts-geneve/?$ https://www.lux-taxi.com/geneva-airport-transfer/ [R=301,L,QSD,NE]
    RewriteRule ^fleet-taxi-geneva/?$ https://www.lux-taxi.com/ [R=301,L,QSD,NE]
    RewriteRule ^geneva-airport-taxi/?$ https://www.lux-taxi.com/geneva-airport-transfer/ [R=301,L,QSD,NE]
