# ==============================================================================
# LT MAISON DE CHAUFFEURS • GENÈVE — CONFIGURATION INFOMANIAK (.htaccess)
# Optimisé pour Apache / LiteSpeed, PHP 8.x, SSL Let's Encrypt & Ultra-Performance
# ==============================================================================

# 1. REDIRECTIONS 301, HTTPS ET VERSION UNIQUE (https://www.lux-taxi.com)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

</IfModule>

# >>> REDIRECTIONS 301 (généré par tools/redirects.py depuis redirects.csv — ne pas modifier à la main)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^fr/?$ https://www.lux-taxi.com/ [R=301,L,QSD,NE]
    RewriteRule ^fr/chauffeur-prive-a-geneve/?$ https://www.lux-taxi.com/ [R=301,L,QSD,NE]
    RewriteRule ^service/airport-transfer-geneva/?$ https://www.lux-taxi.com/geneva-airport-transfer/ [R=301,L,QSD,NE]
