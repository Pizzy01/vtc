    RewriteRule ^service/luggage-parcel-delivery-service-geneva/?$ https://www.lux-taxi.com/geneva-airport-transfer/ [R=301,L,QSD,NE]
    RewriteRule ^fr/notre-flotte/?$ https://www.lux-taxi.com/ [R=301,L,QSD,NE]
    RewriteRule ^service/taxi-geneva/?$ https://www.lux-taxi.com/ [R=301,L,QSD,NE]
    RewriteRule ^contact-taxi-geneva/?$ https://www.lux-taxi.com/ [R=301,L,QSD,NE]
    RewriteRule ^how-to-get-a-taxi-at-geneva-airport/?$ https://www.lux-taxi.com/geneva-airport-transfer/ [R=301,L,QSD,NE]
